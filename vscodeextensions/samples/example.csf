// Pre-Processor directives
#compile "main.csf"
#link "library.obj"
#const MAX_COUNT 100

// Peripheral declaration
using myFunc = int SomeObject.Method(int, string);

// Global variables
global int counter = 0;
global string name = "hello";
global bool flag = true;
global number pi = 3.14;
global object obj = null;

// Function declaration
function void main()
    local int i = 0;
    local number result = 0.0;
    local string msg = "Hello, World!\n";

    // For loop
    for (i = 0; i < MAX_COUNT; i++)
        result = result + 1.5;
        if (result >= 100.0)
            break;
        end
    end

    // While loop
    while (flag)
        counter = counter + 1;
        if (counter == 10)
            flag = false;
        end
    end

    // If-else statement
    if (counter > 5)
        myFunc(counter, "done");
    else
        myFunc(0, "not done");
    end

    // Operators
    local int a = 10;
    local int b = 20;
    local int c = a + b * 2 - 1;
    c = c / 3;
    a += 5;
    b -= 3;
    a = a & b;
    a = a | b;
    a = a ^ b;
    local bool cond = (a == b) || (a != c) && !(a < b);
    local int shifted = a << 2;
    shifted = b >> 1;
    ++a;
    --b;

    return;
end

function int add(int x, int y)
    return x + y;
end
