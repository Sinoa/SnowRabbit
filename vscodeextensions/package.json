{
  "name": "snowrabbit-script-syntax-highlighting",
  "displayName": "雪兎スクリプト構文ハイライト",
  "description": "雪兎の構文を見やすくするために構文のハイライトを行います。",
  "version": "0.0.1",
  "publisher": "Osapon",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "srs",
        "aliases": [
          "SnowRabbit Script",
          "srs"
        ],
        "extensions": [
          ".srs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "srs",
        "scopeName": "source.srs",
        "path": "./syntaxes/srs.tmLanguage.json"
      }
    ]
  }
}
