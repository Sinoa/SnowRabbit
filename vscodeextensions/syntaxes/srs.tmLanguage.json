{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SnowRabbit Script",
  "scopeName": "source.srs",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#preprocessor" },
    { "include": "#keyword-declaration" },
    { "include": "#keyword-control" },
    { "include": "#type" },
    { "include": "#constant-language" },
    { "include": "#constant-numeric" },
    { "include": "#function-call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.srs",
      "match": "//.*$"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.srs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.srs",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.srs",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.srs",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "preprocessor": {
      "match": "^\\s*(#)(compile|link|const)\\b",
      "captures": {
        "1": { "name": "keyword.control.directive.srs" },
        "2": { "name": "keyword.control.directive.srs" }
      }
    },
    "keyword-declaration": {
      "name": "keyword.declaration.srs",
      "match": "\\b(function|using|global|local)\\b"
    },
    "keyword-control": {
      "name": "keyword.control.srs",
      "match": "\\b(if|else|for|while|break|return|end)\\b"
    },
    "type": {
      "name": "support.type.srs",
      "match": "\\b(void|int|number|string|object|bool)\\b"
    },
    "constant-language": {
      "name": "constant.language.srs",
      "match": "\\b(true|false|null)\\b"
    },
    "constant-numeric": {
      "patterns": [
        {
          "name": "constant.numeric.hex.srs",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.srs",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.srs",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.srs" }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.srs",
          "match": "\\+\\=|\\-\\=|\\*\\=|\\/\\=|&\\=|\\|\\=|\\^\\=|(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.srs",
          "match": "==|!=|<=|>=|<<?|>>?"
        },
        {
          "name": "keyword.operator.logical.srs",
          "match": "\\|\\||&&|!"
        },
        {
          "name": "keyword.operator.bitwise.srs",
          "match": "[&|^]"
        },
        {
          "name": "keyword.operator.increment-decrement.srs",
          "match": "\\+\\+|\\-\\-"
        },
        {
          "name": "keyword.operator.arithmetic.srs",
          "match": "[+\\-*/%]"
        }
      ]
    }
  }
}
